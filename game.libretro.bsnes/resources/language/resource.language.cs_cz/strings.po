msgctxt "Addon Summary"
msgid "Nintendo - SNES / SFC (bsnes)"
msgstr "Nintendo - SNES / SFC (bsnes)"

msgctxt "Addon Description"
msgid "bsnes is a multi-platform Super Nintendo (Super Famicom) emulator from Near / Byuu that focuses on performance, features, and ease of use."
msgstr "bsnes je multiplatformní emulátor Super Nintendo (Super Famicom) od Near / Byuu, který se zaměřuje na výkon, funkce a snadné používání."

msgctxt "Addon Disclaimer"
msgid "In loving memory of Near / Byuu"
msgstr "S láskou na památku Near / Byuu"

